# Dockerfile.paho – Build and run the Paho MQTT C perf test on Ubuntu 24.04.
#
# Build context is tests/client-comp/.
# Paho is fetched automatically via CMake FetchContent.

# ── Build stage ───────────────────────────────────────────────
FROM ubuntu:24.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy project tree (needed for library + deps – Paho CMake also needs the az_mqtt tree)
COPY CMakeLists.txt ./
COPY deps/ ./deps/
COPY inc/ ./inc/
COPY src/ ./src/
COPY tests/client-comp/CMakeLists.txt tests/client-comp/
COPY tests/client-comp/perf_az_mqtt5.c tests/client-comp/
COPY tests/client-comp/perf_paho.c tests/client-comp/

# Build only the perf binary
RUN cmake -S tests/client-comp -B out -DCMAKE_BUILD_TYPE=Release \
        -DAZ_MQTT_ROOT=/build \
        -DAZ_MQTT_BUILD_SAMPLES=OFF \
        -DAZ_MQTT_BUILD_TESTS=OFF \
    && cmake --build out --config Release --target perf_paho

# ── Runtime stage ─────────────────────────────────────────────
FROM ubuntu:24.04

COPY --from=builder /build/out/perf_paho /usr/local/bin/perf_paho

ENTRYPOINT ["perf_paho"]
CMD ["localhost", "1883", "10000", "128", "30"]
